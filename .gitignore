# Ignore all files and directories that should not be tracked by git
# This includes temporary files, build artifacts, and other non-essential files

# Ignore all files in the root directory that are not needed for version control
# This includes log files, cache files, and other temporary files
*.log
*.tmp
*.cache
*.temp

# Ignore all files in the src directory that are not needed for version control
# This includes temporary files, build artifacts, and other non-essential files
src/**/*.log
src/**/*.tmp
src/**/*.cache
src/**/*.temp

# Ignore all files in the tests directory that are not needed for version control
# This includes temporary files, build artifacts, and other non-essential files
tests/**/*.log
tests/**/*.tmp
tests/**/*.cache
tests/**/*.temp

# Ignore all files in the docs directory that are not needed for version control
# This includes temporary files, build artifacts, and other non-essential files
docs/**/*.log
docs/**/*.tmp
docs/**/*.cache
docs/**/*.temp

# Ignore all files in the .git directory
# This is a special case, as the .git directory is not a file but a directory
# We need to ignore it to prevent it from being tracked by git
.git

# Ignore all files in the node_modules directory
# This is a special case, as the node_modules directory is not a file but a directory
# We need to ignore it to prevent it from being tracked by git
node_modules

# Ignore all files in the package-lock.json and yarn.lock files
# These files are not needed for version control and can be regenerated if needed
package-lock.json
yarn.lock

# Ignore all files in the .env file
# This file contains sensitive information and should not be tracked by git
.env